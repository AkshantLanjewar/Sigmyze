{
    "extends": "@tsconfig/node12/tsconfig.json",
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "target": "es2019",
        "jsx": "react",
        "module": "commonjs",
        "sourceMap": true,
        "outDir": "./dist/",
        "skipLibCheck": true,
        "lib": [
            "DOM"
        ],
        "allowJs": true
    },
    "exclude": [
        "./src/server "
    ],
    "include": [
        "./src/client/*",
        "./src/client/types/**/*.d.ts"
, "src/client/u-pages/dashboard-page"    ],
    "awesomeTypescriptLoaderOptions": {
        "useWebpackText": true,
        "useTranspileModule": true,
        "doTypeCheck": true,
        "forkChecker": true
    }
}