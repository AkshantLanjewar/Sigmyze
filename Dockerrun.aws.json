{
    "AWSEBDockerrunVersion": "2",
    "containerDefinitions": [
        {
            "name": "quanta-server",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/quanta:latest",
            "hostname": "quanta-server",
            "portMappings": [
                {
                    "hostPort": 5025,
                    "containerPort": 5025
                }
            ],
            "memoryReservation": 256
        }
    ]
}