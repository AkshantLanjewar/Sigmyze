{
    "AWSEBDockerrunVersion": "2",
    "containerDefinitions": [
        {
            "name": "nginx",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/nginx:latest",
            "hostname": "nginx",
            "essential": true,
            "portMappings": [
                {
                    "hostPort": 443,
                    "containerPort": 443
                },
                {
                    "hostPort": 80,
                    "containerPort": 80
                }
            ],
            "links": ["sigmyze-server", "application", "quanta-server"],
            "memory": 128
        },
        {
            "name": "application",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/application:latest",
            "hostname": "application",
            "portMappings": [
                {
                    "hostPort": 3000,
                    "containerPort": 3000
                }
            ],
            "memory": 256
        },
        {
            "name": "sigmyze-server",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/dotnet:latest",
            "hostname": "sigmyze-server",
            "portMappings": [
                {
                    "hostPort": 2015,
                    "containerPort": 80
                }
            ],
            "memory": 256
        },
        {
            "name": "quanta-server",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/quanta:latest",
            "hostname": "quanta-server",
            "portMappings": [
                {
                    "hostPort": 5025,
                    "containerPort": 5025
                }
            ],
            "memory": 512
        }
    ]
}