{
    "AWSEBDockerrunVersion": "3",
    "containerDefinitions": [
        {
            "name": "nginx",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/nginx-ui:latest",
            "hostname": "nginx",
            "essential": true,
            "portMappings": [
                {
                    "hostPort": 80,
                    "containerPort": 80
                }
            ],
            "links": ["dotnet"],
            "memory": 512
        },
        {
            "name": "dotnet",
            "image": "581758326652.dkr.ecr.us-east-1.amazonaws.com/sigmyze-containers/dotnet:latest",
            "hostname": "dotnet",
            "portMappings": [
                {
                    "hostPort": 8013,
                    "containerPort": 80
                }
            ],
            "memory": 512
        }
    ]
}